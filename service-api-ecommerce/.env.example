# Spring Boot Ecommerce API local environment
# Copy this file to .env before running:
#   cp .env.example .env

# Server
SERVER_PORT=8080

# Local test authentication for Spring Security
# All API examples in docs/local-run-and-test-guide.md use local/local.
SPRING_SECURITY_USER_NAME=local
SPRING_SECURITY_USER_PASSWORD=local

# MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/DATN?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&zeroDateTimeBehavior=CONVERT_TO_NULL
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# JWT auth
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Per-client protection for register, login, refresh and password-reset endpoints.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Password reset OTP via Gmail SMTP.
# Use a Gmail App Password, not your normal Gmail password.
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-account@gmail.com
SPRING_MAIL_PASSWORD=replace-with-gmail-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
APP_MAIL_FROM=your-account@gmail.com
MANAGEMENT_HEALTH_MAIL_ENABLED=false
MANAGEMENT_HEALTH_PROBES_ENABLED=true

# Google OAuth customer login.
# Add this backend redirect URI in Google Cloud Console:
#   http://localhost:8080/login/oauth2/code/google
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_AUTHORIZED_REDIRECT_URI=
GOOGLE_OAUTH_FAILURE_REDIRECT_URI=

# Database migration
FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=true

# Python AI service integration
AI_SERVICE_ENABLED=true

# Use true when Python service is not running and you still want local product cards.
AI_SERVICE_MOCK=false

AI_SERVICE_BASE_URL=http://127.0.0.1:8000

# Must match service-ai INTERNAL_API_KEY.
AI_SERVICE_INTERNAL_API_KEY=change-me

AI_SERVICE_TIMEOUT_SECONDS=600

# AI sync
AI_SERVICE_SYNC_BATCH_SIZE=5
AI_SERVICE_SYNC_CRON=0 */10 * * * *
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456
BOOTSTRAP_ADMIN_FULL_NAME=System Admin

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AVATAR_FOLDER=dacn/avatar
CLOUDINARY_MAX_AVATAR_BYTES=5242880
