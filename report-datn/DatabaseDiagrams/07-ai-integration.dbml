// Sơ đồ nhóm dữ liệu tích hợp và đồng bộ AI

// Các bảng có ghi chú [note: 'Bảng tham chiếu rút gọn'] chỉ dùng để làm rõ quan hệ liên nhóm.

Project ecommerce_ai_integration {

  database_type: 'MySQL'

  Note: 'Sơ đồ nhóm dữ liệu tích hợp và đồng bộ AI'

}

Table ai_sync_job {
  job_id varchar(36) [pk, not null]
  sync_type varchar(50) [not null]
  requested_limit int
  status varchar(20) [not null]
  result_json text
  error_message varchar(255)
  created_at timestamp(6) [not null]
  started_at timestamp(6)
  completed_at timestamp(6)
  updated_at timestamp(6) [not null]
}

Table ai_sync_state {
  id bigint [pk, not null, increment]
  sync_name varchar(100) [not null, unique]
  last_success_at timestamp(6)
  updated_at timestamp(6) [not null]
}

Table chat_sessions {
  id bigint [pk, not null, increment]
  session_key varchar(120) [not null, unique]
  user_account_id bigint
  external_user_id varchar(120)
  locale varchar(20) [not null]
  status varchar(50) [not null]
  last_message_at datetime(6)
  created_at datetime(6)
  updated_at datetime(6)
}

Table chat_messages {
  id bigint [pk, not null, increment]
  chat_session_id bigint [not null]
  user_account_id bigint
  external_user_id varchar(120)
  user_message text
  assistant_message text
  image_present boolean [not null]
  image_metadata text
  filters_json text
  rewritten_query varchar(1000)
  warnings_json text
  status varchar(50) [not null]
  created_at datetime(6)
  updated_at datetime(6)
}

Table chat_message_products {
  id bigint [pk, not null, increment]
  chat_message_id bigint [not null]
  product_id bigint
  ai_product_id varchar(120) [not null]
  rank_position int [not null]
  score decimal(12,6)
  source varchar(50)
  product_snapshot_json text
  created_at datetime(6)

  indexes {
    (chat_message_id, rank_position) [unique]
  }
}

Table chat_feedback {
  id bigint [pk, not null, increment]
  chat_message_id bigint [not null, unique]
  user_account_id bigint
  external_user_id varchar(120)
  rating int
  helpful boolean
  feedback_type varchar(50)
  comment text
  created_at datetime(6)
  updated_at datetime(6)
}

Table user_accounts [note: 'Bảng tham chiếu rút gọn'] {
  id bigint [pk, not null, increment]
}

Table products [note: 'Bảng tham chiếu rút gọn'] {
  id bigint [pk, not null]
}

Ref: chat_feedback.chat_message_id > chat_messages.id [delete: cascade]

Ref: chat_feedback.user_account_id > user_accounts.id [delete: set null]

Ref: chat_message_products.chat_message_id > chat_messages.id [delete: cascade]

Ref: chat_message_products.product_id > products.id [delete: set null]

Ref: chat_messages.chat_session_id > chat_sessions.id [delete: cascade]

Ref: chat_messages.user_account_id > user_accounts.id [delete: set null]

Ref: chat_sessions.user_account_id > user_accounts.id [delete: set null]


