// Sơ đồ nhóm dữ liệu người dùng và phân quyền

// Các bảng có ghi chú [note: 'Bảng tham chiếu rút gọn'] chỉ dùng để làm rõ quan hệ liên nhóm.

Project ecommerce_user_authorization {

  database_type: 'MySQL'

  Note: 'Sơ đồ nhóm dữ liệu người dùng và phân quyền'

}

Table user_accounts {
  id bigint [pk, not null, increment]
  email varchar(320) [not null, unique]
  phone_number varchar(30) [unique]
  password_hash varchar(255) [not null]
  password_login_enabled boolean
  full_name varchar(150)
  display_name varchar(150)
  status varchar(50) [not null]
  email_verified boolean
  phone_verified boolean
  last_login_at datetime(6)
  created_at datetime(6)
  updated_at datetime(6)
}

Table user_roles {
  id bigint [pk, not null, increment]
  name varchar(100) [not null, unique]
  description varchar(255)
  active boolean
  created_at datetime(6)
  updated_at datetime(6)
}

Table user_account_roles {
  user_account_id bigint [not null]
  role_id bigint [not null]

  indexes {
    (user_account_id, role_id) [pk]
  }
}

Table customer_profiles {
  id bigint [pk, not null, increment]
  user_account_id bigint [not null, unique]
  first_name varchar(100)
  last_name varchar(100)
  gender varchar(50)
  date_of_birth date
  avatar_url text
  loyalty_points int
  marketing_opt_in boolean
  created_at datetime(6)
  updated_at datetime(6)
}

Table customer_addresses {
  id bigint [pk, not null, increment]
  user_account_id bigint [not null]
  address_type varchar(50) [not null]
  recipient_name varchar(150) [not null]
  phone_number varchar(30) [not null]
  address_line1 varchar(255) [not null]
  address_line2 varchar(255)
  ward varchar(150)
  district varchar(150)
  city varchar(150)
  province varchar(150)
  country_code varchar(2) [not null]
  postal_code varchar(20)
  is_default boolean
  deleted boolean
  created_at datetime(6)
  updated_at datetime(6)
}

Table refresh_tokens {
  id bigint [pk, not null, increment]
  user_account_id bigint [not null]
  token_hash varchar(255) [not null, unique]
  status varchar(50) [not null]
  issued_at datetime(6)
  expires_at datetime(6) [not null]
  revoked_at datetime(6)
  replaced_by_token_hash varchar(255)
  ip_address varchar(45)
  user_agent text
  created_at datetime(6)
  updated_at datetime(6)
}

Table password_reset_otps {
  id bigint [pk, not null, increment]
  user_account_id bigint [not null]
  email varchar(320) [not null]
  otp_hash varchar(255) [not null]
  reset_token_hash varchar(255)
  failed_attempts int [not null]
  max_failed_attempts int [not null]
  expires_at datetime(6) [not null]
  reset_token_expires_at datetime(6)
  verified_at datetime(6)
  used_at datetime(6)
  created_at datetime(6)
  updated_at datetime(6)
}

Ref: customer_addresses.user_account_id > user_accounts.id [delete: cascade]

Ref: customer_profiles.user_account_id > user_accounts.id [delete: cascade]

Ref: password_reset_otps.user_account_id > user_accounts.id [delete: cascade]

Ref: refresh_tokens.user_account_id > user_accounts.id [delete: cascade]

Ref: user_account_roles.user_account_id > user_accounts.id [delete: cascade]

Ref: user_account_roles.role_id > user_roles.id [delete: cascade]


