// Sơ đồ nhóm dữ liệu thanh toán và khuyến mãi

// Các bảng có ghi chú [note: 'Bảng tham chiếu rút gọn'] chỉ dùng để làm rõ quan hệ liên nhóm.

Project ecommerce_payment_promotion {

  database_type: 'MySQL'

  Note: 'Sơ đồ nhóm dữ liệu thanh toán và khuyến mãi'

}

Table payments {
  id bigint [pk, not null, increment]
  payment_number varchar(50) [not null, unique]
  order_id bigint [not null]
  user_account_id bigint [not null]
  method varchar(50) [not null]
  status varchar(50) [not null]
  amount decimal(12,2) [not null]
  refunded_amount decimal(12,2) [not null]
  currency varchar(3) [not null]
  provider varchar(50)
  gateway_payment_id varchar(150)
  gateway_order_id varchar(150)
  idempotency_key varchar(100) [unique]
  requested_at datetime(6)
  authorized_at datetime(6)
  paid_at datetime(6)
  failed_at datetime(6)
  cancelled_at datetime(6)
  refunded_at datetime(6)
  expires_at datetime(6)
  failure_code varchar(100)
  failure_message varchar(255)
  metadata text
  created_at datetime(6)
  updated_at datetime(6)

  indexes {
    (provider, gateway_payment_id) [unique]
  }
}

Table payment_transactions {
  id bigint [pk, not null, increment]
  payment_id bigint [not null]
  order_id bigint [not null]
  transaction_type varchar(50) [not null]
  status varchar(50) [not null]
  amount decimal(12,2) [not null]
  currency varchar(3) [not null]
  provider varchar(50)
  gateway_transaction_id varchar(150)
  gateway_payment_id varchar(150)
  idempotency_key varchar(100) [unique]
  failure_code varchar(100)
  failure_message varchar(255)
  request_payload text
  response_payload text
  processed_at datetime(6)
  created_at datetime(6)

  indexes {
    (provider, gateway_transaction_id) [unique]
  }
}

Table payment_webhook_events {
  id bigint [pk, not null, increment]
  provider varchar(50) [not null]
  event_id varchar(150) [not null]
  event_type varchar(100)
  payment_id bigint
  payment_transaction_id bigint
  gateway_payment_id varchar(150)
  gateway_transaction_id varchar(150)
  processing_status varchar(50) [not null]
  headers text
  payload text [not null]
  signature varchar(255)
  received_at datetime(6)
  processed_at datetime(6)
  error_message text
  created_at datetime(6)
  updated_at datetime(6)

  indexes {
    (provider, event_id) [unique]
  }
}

Table promotions {
  id bigint [pk, not null, increment]
  name varchar(150) [not null]
  description text
  discount_type varchar(50) [not null]
  discount_value decimal(12,2) [not null]
  max_discount_amount decimal(12,2)
  min_order_amount decimal(12,2) [not null]
  currency varchar(3) [not null]
  status varchar(50) [not null]
  priority int [not null]
  stackable boolean
  customer_scope varchar(50) [not null]
  eligible_user_account_id bigint
  customer_segment varchar(100)
  starts_at datetime(6)
  ends_at datetime(6)
  created_at datetime(6)
  updated_at datetime(6)
}

Table promotion_products {
  id bigint [pk, not null, increment]
  promotion_id bigint [not null]
  product_id bigint [not null]
  active boolean
  created_at datetime(6)

  indexes {
    (promotion_id, product_id) [unique]
  }
}

Table promotion_categories {
  id bigint [pk, not null, increment]
  promotion_id bigint [not null]
  category_id bigint [not null]
  active boolean
  created_at datetime(6)

  indexes {
    (promotion_id, category_id) [unique]
  }
}

Table coupons {
  id bigint [pk, not null, increment]
  code varchar(50) [not null, unique]
  name varchar(150) [not null]
  description text
  discount_type varchar(50) [not null]
  discount_value decimal(12,2) [not null]
  max_discount_amount decimal(12,2)
  min_order_amount decimal(12,2) [not null]
  currency varchar(3) [not null]
  usage_limit int
  usage_limit_per_user int
  used_count int [not null]
  status varchar(50) [not null]
  customer_scope varchar(50) [not null]
  eligible_user_account_id bigint
  customer_segment varchar(100)
  starts_at datetime(6)
  ends_at datetime(6)
  created_at datetime(6)
  updated_at datetime(6)
}

Table coupon_redemptions {
  id bigint [pk, not null, increment]
  coupon_id bigint [not null]
  user_account_id bigint [not null]
  order_id bigint
  redemption_key varchar(100) [unique]
  coupon_code varchar(50) [not null]
  discount_type varchar(50) [not null]
  discount_value decimal(12,2) [not null]
  discount_amount decimal(12,2) [not null]
  order_amount decimal(12,2) [not null]
  currency varchar(3) [not null]
  status varchar(50) [not null]
  redeemed_at datetime(6)
  cancelled_at datetime(6)
  cancel_reason varchar(150)
  created_at datetime(6)
  updated_at datetime(6)

  indexes {
    (coupon_id, order_id) [unique]
  }
}

Table orders [note: 'Bảng tham chiếu rút gọn'] {
  id bigint [pk, not null, increment]
}

Table user_accounts [note: 'Bảng tham chiếu rút gọn'] {
  id bigint [pk, not null, increment]
}

Table products [note: 'Bảng tham chiếu rút gọn'] {
  id bigint [pk, not null]
}

Table categories [note: 'Bảng tham chiếu rút gọn'] {
  id bigint [pk, not null, increment]
}

Ref: coupon_redemptions.coupon_id > coupons.id [delete: cascade]

Ref: coupon_redemptions.order_id > orders.id [delete: set null]

Ref: coupon_redemptions.user_account_id > user_accounts.id [delete: cascade]

Ref: coupons.eligible_user_account_id > user_accounts.id [delete: set null]

Ref: payment_transactions.order_id > orders.id [delete: cascade]

Ref: payment_transactions.payment_id > payments.id [delete: cascade]

Ref: payment_webhook_events.payment_id > payments.id [delete: set null]

Ref: payment_webhook_events.payment_transaction_id > payment_transactions.id [delete: set null]

Ref: payments.order_id > orders.id [delete: cascade]

Ref: payments.user_account_id > user_accounts.id [delete: cascade]

Ref: promotion_categories.category_id > categories.id [delete: cascade]

Ref: promotion_categories.promotion_id > promotions.id [delete: cascade]

Ref: promotion_products.product_id > products.id [delete: cascade]

Ref: promotion_products.promotion_id > promotions.id [delete: cascade]

Ref: promotions.eligible_user_account_id > user_accounts.id [delete: set null]

