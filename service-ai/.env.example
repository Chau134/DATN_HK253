# Python FastAPI AI service local environment
# Copy this file to .env before running:
#   cp .env.example .env

# App
APP_NAME=ai-ecommerce-assistant
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Security
# INTERNAL_API_KEY must match service-api-ecommerce AI_SERVICE_INTERNAL_API_KEY.
INTERNAL_API_KEY=change-me

# Python -> Spring internal calls. Must match AI_SERVICE_INTERNAL_API_KEY.
SPRINGBOOT_API_KEY=change-me

# Spring Boot Ecommerce
# Docker standalone: reach Spring Boot running on the host.
SPRINGBOOT_BASE_URL=http://host.docker.internal:8080
SPRINGBOOT_PRODUCT_SEARCH_ENDPOINT=/api/products/search
SPRINGBOOT_PRODUCT_DETAIL_ENDPOINT=/api/products
SPRINGBOOT_PRODUCT_CONTEXT_ENDPOINT=/api/internal/ai/products/context
SPRINGBOOT_TIMEOUT_SECONDS=10
SPRINGBOOT_RETRY_ATTEMPTS=2
SPRINGBOOT_RETRY_BACKOFF_SECONDS=0.25
ASSISTANT_PRODUCT_CONTEXT_LIMIT=5
ASSISTANT_PRODUCT_CONTEXT_TIMEOUT_SECONDS=5
ASSISTANT_PRODUCT_CONTEXT_RETRY_ATTEMPTS=1
ASSISTANT_PRODUCT_CONTEXT_CIRCUIT_FAILURE_THRESHOLD=2
ASSISTANT_PRODUCT_CONTEXT_CIRCUIT_RESET_SECONDS=30

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_STORAGE_PATH=../qdrant_storage_1000_recovered_20260821
QDRANT_TEXT_COLLECTION=product_text_vectors_cohere_embed_v4_1536_metadata_v4_1000_products
QDRANT_IMAGE_COLLECTION=product_image_vectors_cohere_embed_v4_1536_1000_products
QDRANT_TEXT_VECTOR_SIZE=1536
QDRANT_IMAGE_VECTOR_SIZE=1536
QDRANT_DISTANCE=COSINE

LLM_PROVIDER=bedrock
BEDROCK_REGION=ap-northeast-1
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
BEDROCK_TEMPERATURE=0.2
BEDROCK_MAX_TOKENS=2048
BEDROCK_QUERY_UNDERSTANDING_MAX_TOKENS=1536
BEDROCK_TIMEOUT_SECONDS=30
BEDROCK_RETRY_ATTEMPTS=2

YOLO_ENABLED=false
YOLO_WEIGHTS_PATH=./Resource/best.pt
YOLO_DEVICE=cpu
YOLO_CONF_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.5
YOLO_INPUT_SIZE=640
YOLO_MIN_CROP_SIDE_PX=24

EMBEDDING_PROVIDER=bedrock
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL_NAME=embed-v4.0
BEDROCK_EMBEDDING_MODEL_ID=cohere.embed-v4:0
BEDROCK_EMBEDDING_IMAGE_MAX_SIDE=512
BEDROCK_EMBEDDING_MIN_REQUEST_INTERVAL_SECONDS=1
BEDROCK_EMBEDDING_THROTTLE_RETRY_ATTEMPTS=6
BEDROCK_EMBEDDING_THROTTLE_BACKOFF_SECONDS=2
BEDROCK_EMBEDDING_THROTTLE_MAX_BACKOFF_SECONDS=30
VERTEX_EMBEDDING_MODEL_NAME=gemini-embedding-2
EMBEDDING_OUTPUT_DIMENSIONALITY=1536
GOOGLE_CLOUD_PROJECT=project-7a5551d7-985f-4ecc-985
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_API_VERSION=v1beta
GOOGLE_CLOUD_API_KEY=
GOOGLE_CLOUD_API_KEY_FILE=

GOOGLE_CLOUD_RERANKER_ACCESS_TOKEN_FILE=.secrets/reranker-access-token

TEXT_EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-8B
IMAGE_EMBEDDING_MODEL_NAME=Qwen/Qwen3-VL-Embedding-2B
IMAGE_EMBEDDING_TRUST_REMOTE_CODE=true
EMBEDDING_DEVICE=cuda

EMBEDDING_DTYPE=float16
EMBEDDING_BATCH_SIZE=8
NORMALIZE_EMBEDDINGS=true

TEXT_EMBEDDING_USE_PROMPT=true
TEXT_EMBEDDING_QUERY_INSTRUCTION=Given a shopping search query, retrieve relevant product descriptions
TEXT_EMBEDDING_QUERY_PROMPT=Instruct: {task}\nQuery: {text}

# Upload
TEMP_UPLOAD_DIR=./tmp/uploads
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
IMAGE_MIN_WIDTH=1
IMAGE_MIN_HEIGHT=1
IMAGE_MAX_SIDE=1600

# Search
TEXT_TOP_K=5
IMAGE_TOP_K=5
MAX_SEARCH_TOP_K=50
IMAGE_CANDIDATE_POOL_SIZE=20

IMAGE_PRODUCT_OVERFETCH_FACTOR=4
IMAGE_QUERY_PER_CROP_LIMIT_CAP=200

IMAGE_YOLO_CATEGORY_SOFT_BOOST_WEIGHT=0.03
IMAGE_YOLO_CATEGORY_SOFT_MIN_CONFIDENCE=0.35
IMAGE_YOLO_CATEGORY_HARD_FILTER_CONFIDENCE=0.90
IMAGE_YOLO_CATEGORY_HARD_FILTER_CLASS_IDS=
IMAGE_BUSINESS_BOOST_ENABLED=false
IMAGE_BUSINESS_BOOST_WEIGHT=0.02
HYBRID_TOP_K=5
HYBRID_CANDIDATE_POOL_SIZE=50
HYBRID_PRODUCT_OVERFETCH_FACTOR=4
HYBRID_CANDIDATE_POOL_CAP=100
RERANK_TOP_K=20
HYBRID_IMAGE_WEIGHT=0.45
HYBRID_TEXT_WEIGHT=0.35
HYBRID_FILTER_WEIGHT=0.15
HYBRID_BUSINESS_WEIGHT=0.05
HYBRID_SOFT_ATTRIBUTE_BOOST_ENABLED=true
HYBRID_USE_CASE_OVERLAP_BOOST_ENABLED=true
HYBRID_COLOR_BOOST_WEIGHT=0.05
HYBRID_GENDER_BOOST_WEIGHT=0.03

TEXT_SOFT_ATTRIBUTE_BOOST_ENABLED=true
TEXT_TRUSTED_COLOR_HARD_FILTER_ENABLED=true
TEXT_BUSINESS_BOOST_ENABLED=true
TEXT_COLOR_BOOST_WEIGHT=0.05
TEXT_GENDER_BOOST_WEIGHT=0.03
TEXT_BUSINESS_BOOST_WEIGHT=0.02
TEXT_USE_CASE_BOOST_WEIGHT=0.10

RERANK_ENABLED=false
RERANKER_MODEL_NAME=semantic-ranker-default@latest
RERANKER_LOCATION=global
RERANKER_CONFIG_ID=default_ranking_config
RERANKER_TIMEOUT_SECONDS=10

PRELOAD_MODELS=true

# LangGraph memory/checkpoint
CHECKPOINT_BACKEND=sqlite
SQLITE_CHECKPOINT_PATH=./data/langgraph_checkpoints.sqlite
POSTGRES_DSN=
REDIS_URL=
ASSISTANT_RECENT_MESSAGE_LIMIT=12
ASSISTANT_CONVERSATION_SUMMARY_MAX_CHARS=3000
ASSISTANT_CONVERSATION_CONTEXT_MAX_CHARS=8000
ASSISTANT_QUERY_CONTEXT_MAX_CHARS=4000
ASSISTANT_USER_MEMORY_ENABLED=true
ASSISTANT_USER_MEMORY_BACKEND=auto
ASSISTANT_USER_MEMORY_TTL_SECONDS=15552000
ASSISTANT_USER_MEMORY_MAX_NOTES=5
# Evaluation-only ablation. Keep `rag` outside controlled A/B runs.
ASSISTANT_EVALUATION_VARIANT=rag
ASSISTANT_EVAL_TRACE_ENABLED=true
ASSISTANT_PRODUCT_CONTEXT_CACHE_TTL_SECONDS=300
ASSISTANT_PRODUCT_CONTEXT_CACHE_SIZE=2000
ASSISTANT_PRODUCT_CONTEXT_STALE_TTL_SECONDS=1800
TEXT_LLM_ANALYSIS_CACHE_TTL_SECONDS=300
TEXT_LLM_ANALYSIS_CACHE_SIZE=512
TEXT_QUERY_EMBEDDING_CACHE_TTL_SECONDS=600
TEXT_QUERY_EMBEDDING_CACHE_SIZE=1000

# Observability, optional
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
